rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Check if the user is an admin by email or role
    function isAdmin() {
      return request.auth != null && (
        request.auth.token.email == "rolan.bacalla@gmail.com" ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin"
      );
    }

    // Destinations: Publicly readable, but only admins can write
    match /destinations/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Users: Users can read their own or others (public profile info), Admins can write all
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
      
      allow create: if request.auth != null && request.auth.uid == userId
                    && !request.resource.data.keys().hasAny(['role', 'isVerified', 'status']);
                    
      allow update: if request.auth != null && request.auth.uid == userId
                    && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'isVerified', 'status']));
    }

    // Default deny for anything else
    match /{document=**} {
      allow read, write: if false;
    }
  }
}